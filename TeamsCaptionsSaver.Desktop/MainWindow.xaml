<Window x:Class="TeamsCaptionsSaver.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teams Captions Saver" Height="640" Width="900" MinHeight="400" MinWidth="620"
        Icon="icon.ico" WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status -->
        <Border Grid.Row="0" Padding="10,8" CornerRadius="6" Background="#F3F4F6" Margin="0,0,0,10">
            <DockPanel>
                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#555" />
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="14" Text="Starting…" />
                    <TextBlock x:Name="StatusDetail" Foreground="#555" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Actions -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="PauseButton" Content="Pause capture" Click="OnPauseClick" />
            <Button Content="Save as…" Click="OnSaveAsClick" />
            <Button Content="Save (selected formats)" Click="OnSaveAllClick" />
            <Button Content="New transcript" Click="OnNewSessionClick" />
            <Button Content="Open folder" Click="OnOpenFolderClick" />
            <Button Content="Diagnostics" Click="OnDiagnosticsClick"
                    ToolTip="Dump the Teams UI tree to a file - useful if captions aren't being picked up." />
        </WrapPanel>

        <!-- Transcript -->
        <DataGrid Grid.Row="2" x:Name="TranscriptGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                  SelectionMode="Extended" CanUserSortColumns="False" RowHeaderWidth="0"
                  VirtualizingPanel.ScrollUnit="Pixel" BorderBrush="#D1D5DB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="70" />
                <DataGridTextColumn Header="Speaker" Binding="{Binding Speaker}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Rename speaker…" Click="OnRenameSpeakerClick" />
                    <MenuItem Header="Copy" Click="OnCopyClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Settings -->
        <Expander Grid.Row="3" Header="Settings" Margin="0,10,0,0">
            <Grid Margin="4,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Save to:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="FolderBox" Grid.Column="1" VerticalContentAlignment="Center" Padding="3"
                         LostFocus="OnSettingChanged" />
                <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseClick" />

                <TextBlock Grid.Row="1" Text="File name:" VerticalAlignment="Center" Margin="0,6,8,0" />
                <TextBox x:Name="PatternBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Padding="3"
                         VerticalContentAlignment="Center" LostFocus="OnSettingChanged"
                         ToolTip="Variables: {date} {time} {title}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{}{date} {time} {title}" Foreground="#777"
                           VerticalAlignment="Center" Margin="6,6,0,0" />

                <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <TextBlock Text="Formats:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <WrapPanel x:Name="FormatsPanel" />
                </WrapPanel>

                <WrapPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,4,0,0">
                    <CheckBox x:Name="AutoSaveBox" Content="Auto-save when the meeting ends" Click="OnSettingChanged" />
                    <CheckBox x:Name="AutoEnableBox" Content="Turn on Teams live captions automatically" Click="OnSettingChanged" />
                    <CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" Click="OnSettingChanged" />
                </WrapPanel>
            </Grid>
        </Expander>

        <TextBlock Grid.Row="4" x:Name="LogLine" Foreground="#888" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
