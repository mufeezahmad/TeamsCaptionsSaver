<Window x:Class="TeamsCaptionsSaver.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TeamsCaptionsSaver.Desktop"
        Title="Teams Captions Saver" Height="640" Width="900" MinHeight="400" MinWidth="620"
        Icon="icon.ico" WindowStartupLocation="CenterScreen"
        Closing="OnClosing" PreviewKeyDown="OnWindowKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Status -->
        <Border Grid.Row="0" Padding="10,8" CornerRadius="6" Background="#F3F4F6" Margin="0,0,0,10">
            <DockPanel>
                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="Gray" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#555" />
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="14" Text="Starting…" />
                    <TextBlock x:Name="StatusDetail" Foreground="#555" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Actions -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="PauseButton" Content="Pause capture" Click="OnPauseClick" />
            <Button Content="Copy all" Click="OnCopyAllClick"
                    ToolTip="Copy the whole transcript to the clipboard, ready to paste anywhere." />
            <Button Content="Save as…" Click="OnSaveAsClick" />
            <Button Content="Save (selected formats)" Click="OnSaveAllClick" />
            <Button Content="New transcript" Click="OnNewSessionClick" />
            <Button Content="Open folder" Click="OnOpenFolderClick" />
            <Button Content="Diagnostics" Click="OnDiagnosticsClick"
                    ToolTip="Dump the Teams UI tree to a file - useful if captions aren't being picked up." />
        </WrapPanel>

        <!-- Filters: search and chosen speakers. Copy and Save use what's shown. -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <Grid Width="280" DockPanel.Dock="Left">
                <TextBox x:Name="SearchBox" Padding="24,4,6,4" VerticalContentAlignment="Center"
                         TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                         ToolTip="Show only turns containing this text (Ctrl+F). Esc clears it." />
                <TextBlock Text="🔍" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="#888" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="Search transcript (Ctrl+F)" Margin="26,0,0,0"
                           VerticalAlignment="Center" Foreground="#999" IsHitTestVisible="False" />
            </Grid>
            <ToggleButton x:Name="SpeakersButton" Content="Speakers ▾" Margin="8,0,0,0" Padding="10,4"
                          Checked="OnSpeakersPopupOpening" ToolTip="Choose which speakers to show" />
            <Popup x:Name="SpeakersPopup" PlacementTarget="{Binding ElementName=SpeakersButton}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True"
                   IsOpen="{Binding IsChecked, ElementName=SpeakersButton, Mode=TwoWay}">
                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6"
                        Padding="10" MinWidth="230" Margin="0,4,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="All" MinWidth="50" Padding="8,2" Click="OnShowAllSpeakersClick" />
                            <Button Content="None" MinWidth="50" Padding="8,2" Click="OnHideAllSpeakersClick" />
                        </StackPanel>
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SpeakerList" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
            <CheckBox x:Name="MarkedOnlyBox" Content="Only ★ / highlighted" Margin="12,0,0,0"
                      Checked="OnMarkedOnlyChanged" Unchecked="OnMarkedOnlyChanged"
                      ToolTip="Show only starred lines and lines with highlighted words" />
            <Button x:Name="ClearFilterButton" Content="Clear filters" Margin="8,0,0,0" Visibility="Collapsed"
                    Click="OnClearFiltersClick" />
            <TextBlock x:Name="FilterStatus" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#555"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Transcript -->
        <DataGrid Grid.Row="3" x:Name="TranscriptGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB"
                  SelectionMode="Extended" CanUserSortColumns="False" RowHeaderWidth="0"
                  VirtualizingPanel.ScrollUnit="Pixel" BorderBrush="#D1D5DB"
                  SelectionChanged="OnGridSelectionChanged">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="30" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Click="OnStarClick" Focusable="False" Cursor="Hand" FontSize="15"
                                    ToolTip="Bookmark this line (Ctrl+B)">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="☆" />
                                        <Setter Property="Foreground" Value="#9CA3AF" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBookmarked}" Value="True">
                                                <Setter Property="Content" Value="★" />
                                                <Setter Property="Foreground" Value="#F59E0B" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeDisplay}" Width="70" />
                <DataGridTextColumn Header="Speaker" Binding="{Binding Speaker}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Text" Width="*" ClipboardContentBinding="{Binding Text}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,2"
                                       local:Highlighter.Text="{Binding Text}"
                                       local:Highlighter.Phrases="{Binding Highlights}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="★ Bookmark / remove bookmark" InputGestureText="Ctrl+B" Click="OnToggleBookmarkClick" />
                    <Separator />
                    <MenuItem Header="Show only this speaker" Click="OnShowOnlySpeakerClick" />
                    <MenuItem Header="Show all speakers" Click="OnShowAllSpeakersClick" />
                    <Separator />
                    <MenuItem Header="Rename speaker…" Click="OnRenameSpeakerClick" />
                    <MenuItem Header="Copy selected" Click="OnCopyClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Selected turn: select words to highlight them -->
        <Border Grid.Row="4" x:Name="DetailPane" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,8"
                BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Background="#FAFAFB">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="DetailStarButton" Content="★ Bookmark" Click="OnDetailStarClick" />
                        <Button Content="🖍 Highlight" Click="OnHighlightClick"
                                ToolTip="Highlight the words selected below" />
                        <Button Content="Remove highlight" Click="OnRemoveHighlightClick"
                                ToolTip="Remove highlights in the selected words (or all in this line if nothing is selected)" />
                        <Button x:Name="DetailCloseButton" Content="✕" Click="OnCloseDetailClick" ToolTip="Close (Esc)"
                                MinWidth="0" Width="28" Height="26" Padding="0" Margin="4,0,0,0" FontSize="13"
                                Background="Transparent" BorderThickness="0" Foreground="#555" Cursor="Hand" />
                    </StackPanel>
                    <TextBlock x:Name="DetailHeader" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Select words below, then click 🖍 Highlight." Foreground="#888"
                           FontSize="11" Margin="0,0,0,4" />
                <TextBox x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="110"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" />
            </DockPanel>
        </Border>

        <!-- Settings -->
        <Expander Grid.Row="5" Header="Settings" Margin="0,10,0,0">
            <Grid Margin="4,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Save to:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="FolderBox" Grid.Column="1" VerticalContentAlignment="Center" Padding="3"
                         LostFocus="OnSettingChanged" />
                <Button Grid.Column="2" Content="Browse…" Margin="6,0,0,0" Click="OnBrowseClick" />

                <TextBlock Grid.Row="1" Text="File name:" VerticalAlignment="Center" Margin="0,6,8,0" />
                <TextBox x:Name="PatternBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Padding="3"
                         VerticalContentAlignment="Center" LostFocus="OnSettingChanged"
                         ToolTip="Variables: {date} {time} {title}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{}{date} {time} {title}" Foreground="#777"
                           VerticalAlignment="Center" Margin="6,6,0,0" />

                <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0">
                    <TextBlock Text="Formats:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <WrapPanel x:Name="FormatsPanel" />
                </WrapPanel>

                <WrapPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,4,0,0">
                    <CheckBox x:Name="AutoSaveBox" Content="Auto-save when the meeting ends" Click="OnSettingChanged" />
                    <CheckBox x:Name="AutoEnableBox" Content="Turn on Teams live captions automatically" Click="OnSettingChanged" />
                    <CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" Click="OnSettingChanged" />
                </WrapPanel>
            </Grid>
        </Expander>

        <TextBlock Grid.Row="6" x:Name="LogLine" Foreground="#888" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
