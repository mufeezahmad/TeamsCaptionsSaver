<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TeamsCaptionsSaver</AssemblyName>
    <RootNamespace>TeamsCaptionsSaver.Desktop</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Teams Captions Saver (Desktop)</Product>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TeamsCaptionsSaver.Tests" />
    <Resource Include="icon.ico" />
  </ItemGroup>

</Project>
